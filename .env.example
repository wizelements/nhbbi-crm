# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CONTACT_EMAIL=info@nhbbi.org
SUPPORT_EMAIL=support@nhbbi.org
CORS_ORIGINS=http://localhost:3000,https://nhbbi.org
NODE_ENV=development

# Authentication
JWT_SECRET=your-jwt-secret-at-least-32-characters
ADMIN_SETUP_SECRET=your-admin-setup-secret
ADMIN_DEFAULT_EMAIL=admin@nhbbi.org
ADMIN_DEFAULT_PASSWORD=your-secure-admin-password

# Database — Turso/libSQL
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Payments — Square
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_APPLICATION_ID=your_square_application_id
SQUARE_LOCATION_ID=your_square_location_id
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key
SQUARE_WEBHOOK_URL=https://nhbbi.org/api/square/webhook

# Email — Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@nhbbi.org

# Owner Alerts — Telegram
TELEGRAM_BOT_TOKEN=your_cloud_telegram_bot_token
TELEGRAM_CHAT_ID=your_owner_chat_or_group_id
ALERT_EMAIL=owner@nhbbi.org

# Admin / AI Agent
ADMIN_API_TOKEN=your_admin_api_token
AI_AGENT_SECRET=your_ai_agent_secret

# Cron
CRON_SECRET=your_cron_secret

# Feature flags
FEATURE_SUBSCRIPTIONS_ENABLED=true
FEATURE_DIRECTORY_ENABLED=true
FEATURE_JOBS_ENABLED=true
FEATURE_EVENTS_ENABLED=true
